<Project Sdk="Gsharp.NET.Sdk/0.5.26">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="GSharp.Core" HintPath="$([System.IO.Path]::GetDirectoryName('$(GsharpCompilerFullPath)'))/GSharp.Core.dll" />
    <Reference Include="GSharp.Formatting" HintPath="$([System.IO.Path]::GetDirectoryName('$(GsharpCompilerFullPath)'))/../formatter/GSharp.Formatting.dll" />
    <Compile Include="../../deps/Gslint/Program.gs" />
  </ItemGroup>
</Project>
