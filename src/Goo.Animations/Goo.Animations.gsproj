<Project Sdk="Gsharp.NET.Sdk/0.4.591">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Goo.Animations</RootNamespace>
    <AssemblyName>Goo.Animations</AssemblyName>
    <Version>0.1.0</Version>
    <PackageId>Goo.Animations</PackageId>
    <Title>Goo Animations</Title>
    <Authors>obselate</Authors>
    <Description>Reusable animation factories and patterns for Goo Motion.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/obselate/goo-animations</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/obselate/goo-animations</PackageProjectUrl>
    <PackageTags>goo;gsharp;animation;motion;desktop;ui</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DebugType>embedded</DebugType>
    <IncludeSymbols>false</IncludeSymbols>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeAnimationDocumentation</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Goo" Version="[0.6.3]" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
  <Target Name="PopulateAnimationDocumentation" AfterTargets="CoreCompile" Condition="'$(DocumentationFile)' != ''">
    <ItemGroup>
      <DocFileItem Include="$(DocumentationFile)" />
      <FinalDocFile Include="$(OutDir)$([System.IO.Path]::GetFileName('$(DocumentationFile)'))" />
    </ItemGroup>
  </Target>
  <Target Name="IncludeAnimationDocumentation">
    <ItemGroup>
      <BuildOutputInPackage Include="$(TargetDir)Goo.Animations.xml">
        <TargetPath>Goo.Animations.xml</TargetPath>
        <FinalOutputPath>$(TargetDir)Goo.Animations.xml</FinalOutputPath>
      </BuildOutputInPackage>
    </ItemGroup>
  </Target>
</Project>
